{
  "name": "seleto-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "vitest": "vitest --ui",
    "coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "cy:open": "cypress open",
    "cy:open:mobile": "cypress open --config viewportWidth=410,viewportHeight=860",
    "test:component": "cypress run --component",
    "test:mobile": "cypress run --config viewportWidth=410,viewportHeight=860",
    "remove-unused-imports": "tslint --config tslint-imports.json --fix --project .",
    "pretty": "prettier --write \"./**/*.{js,jsx,ts,tsx,json}\"",
    "prepare": "husky",
    "commit": "cz",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.x",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-label": "^2.1.x",
    "@radix-ui/react-slot": "^1.2.x",
    "@types/js-cookie": "^3.0.x",
    "axios": "^1.8.x",
    "class-variance-authority": "^0.7.x",
    "clsx": "^2.1.x",
    "embla-carousel-react": "^8.5.x",
    "i18next": "^25.3.x",
    "js-cookie": "^3.0.x",
    "jwt-decode": "^4.0.x",
    "lucide-react": "^0.476.x",
    "luxon": "^3.5.x",
    "motion": "^12.23.6",
    "next-themes": "^0.4.x",
    "react": "^19.1.x",
    "react-dom": "^19.1.x",
    "react-hook-form": "^7.60.x",
    "react-i18next": "^15.6.x",
    "react-router": "^7.6.x",
    "react-router-dom": "^7.6.x",
    "recharts": "^3.1.0",
    "sonner": "^2.0.x",
    "styled-components": "^6.1.1x",
    "styled-theming": "^2.2.x",
    "tailwind-merge": "^3.3.x",
    "tailwindcss-animate": "^1.0.x",
    "zod": "^3.25.x",
    "zustand": "^5.0.x"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.1",
    "@commitlint/cli": "^19.8.x",
    "@commitlint/config-conventional": "^19.8.x",
    "@eslint/js": "^9.17.x",
    "@faker-js/faker": "^9.3.x",
    "@storybook/addon-a11y": "^9.0.18",
    "@storybook/addon-docs": "^9.0.18",
    "@storybook/addon-onboarding": "^9.0.18",
    "@storybook/addon-vitest": "^9.0.18",
    "@storybook/react-vite": "^9.0.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.x",
    "@testing-library/react": "^16.3.x",
    "@testing-library/user-event": "^14.6.x",
    "@types/luxon": "^3.4.x",
    "@types/node": "^22.13.x",
    "@types/react": "^19.1.x",
    "@types/react-dom": "^19.1.x",
    "@types/styled-theming": "^2.2.x",
    "@vitejs/plugin-react-swc": "^3.10.x",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.x",
    "@vitest/ui": "^3.2.x",
    "autoprefixer": "^10.4.2x",
    "cz-conventional-changelog": "^3.3.x",
    "eslint": "^9.19.x",
    "eslint-config-prettier": "^10.1.x",
    "eslint-plugin-cypress": "^5.1.x",
    "eslint-plugin-prettier": "^5.2.x",
    "eslint-plugin-react": "^7.37.x",
    "eslint-plugin-react-hooks": "^5.2.x",
    "eslint-plugin-react-refresh": "^0.4.x",
    "eslint-plugin-storybook": "^9.0.18",
    "globals": "^16.3.x",
    "husky": "^9.1.x",
    "jest": "^29.5.x",
    "jsdom": "^26.1.x",
    "lint-staged": "^16.1.x",
    "playwright": "^1.54.1",
    "postcss": "^8.5.6",
    "pre-commit": "^1.2.x",
    "prettier": "^3.6.x",
    "rollup-plugin-visualizer": "^6.0.x",
    "standard-version": "^9.5.x",
    "storybook": "^9.0.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.x",
    "typescript-eslint": "^8.35.x",
    "vite": "^7.0.x",
    "vitest": "^3.2.x"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pre-commit": "lint",
  "lint-staged": {
    "*.ts": [
      "eslint --ext=.ts",
      "prettier --write"
    ],
    "*.js": [
      "eslint --ext=.js"
    ]
  }
}
